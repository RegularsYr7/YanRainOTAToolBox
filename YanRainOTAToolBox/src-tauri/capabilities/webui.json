{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "webui",
  "description": "Capability for module WebUI windows (remote HTTP)",
  "windows": ["webui-*"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
